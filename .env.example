# توكن البوت من @BotFather
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# معرف حسابك الشخصي على تليجرام كمسؤول (لتصلك طلبات السحب والموافقة عليها)
# يمكنك معرفته بإرسال أي رسالة لبوت @userinfobot
ADMIN_ID=0

# كود الإعلان من شبكة Adsgram (Block ID)
ADSGRAM_BLOCK_ID=YOUR_ADSGRAM_BLOCK_ID

# المكافأة لكل إعلان مكتمل بالجنيه المصري (مثال: 0.05 = 5 قروش)
REWARD_PER_AD=0.05

# الحد الأدنى للسحب بالجنيه المصري
MIN_WITHDRAWAL=20.0

# وقت الانتظار الأدنى بين الإعلانات بالثواني لمنع التلاعب
AD_COOLDOWN_SECONDS=15

# رابط الميني آب (HTTPS URL) الخاص بالسيرفر
WEB_APP_URL=https://your-domain.com

# منفذ السيرفر المحلي
SERVER_PORT=8000
